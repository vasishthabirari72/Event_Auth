POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://event_auth:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/event_auth
TEST_DATABASE_URL=postgresql+psycopg://event_auth_test:local_test_only@127.0.0.1:5433/event_auth_test
EVENT_AUTH_KEY_FILE=$HOME/.local/share/event-auth/storage.key
EVENT_AUTH_CONFIG=assets/config/customer_config.json
# Localhost development only; use secure cookies + trusted HTTPS for the future LAN setup.
EVENT_AUTH_COOKIE_SECURE=false
EVENT_AUTH_HOSTS=127.0.0.1,localhost
EVENT_AUTH_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

EVENT_AUTH_SIGNING_KEY_FILE=$HOME/.local/share/event-auth/coupon-signing.key
